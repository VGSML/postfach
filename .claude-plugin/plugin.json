{
  "name": "postfach",
  "version": "0.2.0",
  "description": "Email mailbox MCP server with layered prompt-injection screening (heuristics, language allowlist, Prompt Guard 2, guard LLM), e-invoice parsing (XRechnung/ZUGFeRD/Factur-X) and client-defined registries rendered to Register.xlsx for Google Sheets via Drive sync.",
  "author": {
    "name": "hugr-lab"
  },
  "homepage": "https://github.com/hugr-lab/postfach",
  "mcpServers": {
    "postfach": {
      "command": "${CLAUDE_PLUGIN_ROOT}/postfach-mcp",
      "env": {
        "POSTFACH_IMAP_URL": "${POSTFACH_IMAP_URL:-}",
        "POSTFACH_ATTACHMENTS_DIR": "${POSTFACH_ATTACHMENTS_DIR:-}",
        "POSTFACH_ALLOWED_LANGS": "${POSTFACH_ALLOWED_LANGS:-}",
        "POSTFACH_MAX_INLINE_MB": "${POSTFACH_MAX_INLINE_MB:-}",
        "POSTFACH_DOC_LINK_TEMPLATE": "${POSTFACH_DOC_LINK_TEMPLATE:-}",
        "POSTFACH_PG2_MODEL": "${POSTFACH_PG2_MODEL:-}",
        "POSTFACH_ORT_LIB": "${POSTFACH_ORT_LIB:-}",
        "POSTFACH_GUARD_LLM_MODEL": "${POSTFACH_GUARD_LLM_MODEL:-}",
        "POSTFACH_GUARD_LLM_URL": "${POSTFACH_GUARD_LLM_URL:-}"
      }
    }
  }
}
